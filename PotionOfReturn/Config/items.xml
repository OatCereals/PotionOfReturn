<configs>
	<append xpath="/items">
		<item name="drinkJarPotionOfReturn">
			<property name="Tags" value="drinks"/>
			<property name="HoldType" value="3"/>
			<property name="DisplayType" value="porReturnPotion"/>
			<property name="CustomIcon" value="drinkJarBoiledWater"/>
			<property name="CustomIconTint" value="b080ff"/>
			<property name="TintColor" value="140, 80, 200"/>
			<property name="Meshfile" value="@:Other/Items/Food/masonJarWaterPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mglass"/>
			<property name="Stacknumber" value="10"/>
			<!-- Buy uses EconomicValue; sell is halved via EconomicSellScale. -->
			<property name="EconomicValue" value="1500"/>
			<property name="EconomicSellScale" value=".5"/>
			<property name="CraftingIngredientTime" value="30"/>
			<property name="SoundPickup" value="jars_grab"/>
			<property name="SoundPlace" value="jars_place"/>
			<property name="DescriptionKey" value="drinkJarPotionOfReturnDesc"/>
			<property name="UnlockedBy" value="craftingFood"/>
			<property class="Action0">
				<property name="Class" value="Eat"/>
				<property name="Delay" value="4"/>
				<property name="Sound_start" value="player_drinking"/>
				<property name="Create_item" value="drinkJarEmpty"/>
				<property name="Use_jar_refund" value="true"/>
			</property>
			<property name="Group" value="Food/Cooking,CFDrink/Cooking"/>

			<effect_group tiered="false" name="Potion of Return">
				<display_value name="dPorTeleportHome" value="1"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffPotionOfReturnDrinkPending" target="self"/>
			</effect_group>
		</item>
	</append>
</configs>
